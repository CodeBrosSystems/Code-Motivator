{
  "name": "code-motivator",
  "displayName": "Code Motivator",
  "description": "Mensajes motivacionales mientras programas 🚀",
  "version": "0.0.1",
  "publisher": "nacho-ofc",
  "author": {
    "name": "Ignacio Perez"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeBrosSystems/Code-Motivator"
  },
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "motivation",
    "productivity",
    "fun",
    "mensajes",
    "español"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-motivator.motivate",
        "title": "Get Motivated! 🚀"
      }
    ],
    "keybindings": [
      {
        "command": "code-motivator.motivate",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      }
    ],
    "configuration": {
      "title": "Code Motivator",
      "properties": {
        "codeMotivator.messageInterval": {
          "type": "number",
          "default": 300000,
          "description": "Interval in milliseconds between motivational messages"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.39.2",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}